# Project Icarus — environment template. COPY to .env and fill in; .env is git-ignored (CLAUDE.md §7).
# NEVER commit real secrets. On the Hermes deploy PC, prefer a secrets manager / SOPS over a plain .env.
# Separate READ keys (data) from WRITE keys (orders). The Execution agent is the ONLY holder of write
# creds; the research plane gets none of these (invariants #1, #2).

# ---- Runtime ----------------------------------------------------------------
ICARUS_ENV=dev                     # dev | staging | live
ICARUS_GOAL_FILE=goal.yaml
ICARUS_LOG_LEVEL=INFO

# ---- Datastores (Wave B) ----------------------------------------------------
# Local dev via deploy/compose.yaml (Postgres 16 + Valkey 8).
ICARUS_PG_DSN=postgresql+psycopg://icarus:icarus@localhost:5432/icarus
ICARUS_VALKEY_URL=redis://localhost:6379/0

# ---- Compliance / SEBI (invariants #6) --------------------------------------
# The static IP registered with the broker. Execution asserts egress_ip == this before any order path.
# Left blank in dev; set on the live host to the registered Elastic/ISP static IPv4.
ICARUS_REGISTERED_STATIC_IP=

# ---- Zerodha Kite Connect (equities, PRIMARY) — read + write are the SAME key at Kite ----
# NOTE: Kite has no read/write key separation; scope is enforced in code (Phase 0 = writes raise).
KITE_API_KEY=
KITE_API_SECRET=
# access_token is minted daily by the daily-auth agent (0.11); do not paste a long-lived token here.

# ---- Upstox (equities FAILOVER + free backup data feed) ---------------------
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# ---- Delta Exchange India (crypto, INR-settled only, TESTNET in Phase 0) ----
# Trading key MUST have withdrawals DISABLED at the exchange (invariant #8).
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org   # testnet; prod is https://api.india.delta.exchange

# ---- Telegram (oversight / manual kill — separate process, §36.4) -----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- LLM (research plane only; never on the execution path) -----------------
ANTHROPIC_API_KEY=

# ---- Secondary CRITICAL-alert channel (§36.6) -------------------------------
ICARUS_ALERT_EMAIL=
